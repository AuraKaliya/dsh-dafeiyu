{
  "name": "dsh-dafeiyu",
  "version": "0.28.10",
  "type": "module",
  "private": true,
  "description": "大肥鱼：可成长的自主智能体，整合记忆与成长、QQ、B站、多媒体与自主活动。",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./settings": "./lib/settings.js",
    "./installation": "./lib/installation.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dafeiyu": "./bin/dafeiyu.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "dependencies": {
    "@dafeiyu/host": "0.28.10",
    "@dafeiyu/contracts": "0.28.10",
    "@dafeiyu/qq": "0.28.10",
    "@dafeiyu/bilibili": "0.28.10",
    "@dafeiyu/activity": "0.28.10",
    "@dafeiyu/media": "0.28.10",
    "zod": "4.4.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@dafeiyu/memory": "0.28.10",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@dafeiyu/core": "0.28.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5"
  }
}
