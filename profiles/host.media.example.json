{
  "schemaVersion": 1,
  "profileId": "media-local-development",
  "agent": {
    "id": "dafeiyu"
  },
  "paths": {
    "core": "../.runtime/media-local-development/core",
    "memory": "../.runtime/media-local-development/memory",
    "sessions": "../.runtime/media-local-development/sessions",
    "query": "../.runtime/media-local-development/query.sqlite",
    "channels": {
      "qq": "../.runtime/media-local-development/qq"
    }
  },
  "modelRoutes": {
    "chat": {
      "provider": "local-test",
      "model": "scripted"
    }
  },
  "persona": {
    "fixedFile": "./persona.test.md",
    "kind": "test"
  },
  "plugins": [
    {
      "id": "model-scripted",
      "required": true
    },
    {
      "id": "timeline",
      "required": true,
      "config": {
        "execution": true
      }
    },
    {
      "id": "memory-growth",
      "required": true,
      "config": {}
    },
    {
      "id": "media",
      "required": true,
      "config": {
        "ffmpeg": "D:/tools/ffmpeg/bin/ffmpeg.exe",
        "ffprobe": "D:/tools/ffmpeg/bin/ffprobe.exe",
        "documents": {
          "python": "D:/tools/python/python.exe",
          "pypdfVersion": "6.10.0"
        },
        "maxBytes": 1073741824,
        "maxAssetBytes": 67108864,
        "timeoutMs": 120000
      }
    },
    {
      "id": "qq",
      "required": false,
      "config": {
        "botId": "12345678",
        "ownerId": "87654321",
        "groupIds": [
          "11223344"
        ],
        "naturalNames": [
          "大肥鱼",
          "蓝色大肥鱼"
        ],
        "capabilities": {
          "enabled": true
        },
        "tasks": {
          "enabled": true,
          "policyId": "qq-task",
          "deliverResults": true
        },
        "media": {
          "enabled": true,
          "sendEnabled": false,
          "voiceDirectives": false,
          "cacheRoots": [
            "D:/tools/onebot-cache"
          ],
          "httpsHosts": []
        },
        "httpURL": "http://127.0.0.1:13000/",
        "wsURL": "ws://127.0.0.1:13001/",
        "tokenFile": "../.runtime/media-local-development/onebot.token"
      }
    }
  ],
  "authorityPolicies": [
    {
      "id": "local-task",
      "producers": [
        "host-cli"
      ],
      "actions": [
        "dafeiyu_task_intent",
        "dafeiyu_media_acquire",
        "dafeiyu_media_inspect",
        "dafeiyu_media_read",
        "dafeiyu_media_select"
      ],
      "allowLocalWrite": true,
      "resources": []
    },
    {
      "id": "conversation",
      "producers": [
        "channel-qq"
      ],
      "actions": [
        "qq_groups",
        "qq_browse",
        "qq_observe_select",
        "qq_task_submit",
        "qq_task_status",
        "qq_task_control",
        "qq_media_list",
        "dafeiyu_media_acquire",
        "dafeiyu_media_inspect",
        "dafeiyu_media_read",
        "dafeiyu_media_select"
      ],
      "allowLocalWrite": true
    },
    {
      "id": "qq-task",
      "producers": [
        "qq-tasks"
      ],
      "actions": [
        "qq_groups",
        "qq_browse",
        "qq_observe_select",
        "qq_media_list",
        "dafeiyu_task_intent",
        "dafeiyu_task_object",
        "dafeiyu_execution_source_open",
        "dafeiyu_execution_contribute",
        "dafeiyu_execution_select",
        "dafeiyu_media_acquire",
        "dafeiyu_media_inspect",
        "dafeiyu_media_read",
        "dafeiyu_media_select"
      ],
      "allowLocalWrite": true,
      "resources": [],
      "sourceRules": []
    }
  ]
}
