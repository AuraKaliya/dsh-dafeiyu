{
  "name": "dsh-dafeiyu",
  "version": "0.20.0",
  "type": "module",
  "description": "大肥鱼：可成长的自主智能体，整合记忆与成长、QQ、B站、多媒体与自主活动。",
  "license": "MIT",
  "main": "./runtime/plugin/lib/index.js",
  "types": "./runtime/plugin/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./runtime/plugin/lib/index.d.ts",
      "default": "./runtime/plugin/lib/index.js"
    },
    "./settings": "./runtime/plugin/lib/settings.js",
    "./installation": "./runtime/plugin/lib/installation.js"
  },
  "bin": {
    "dafeiyu": "./bin/dafeiyu.mjs"
  },
  "files": [
    "runtime",
    "bin",
    "examples",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=24.13.0 <25",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AuraKaliya/dsh-dafeiyu.git"
  },
  "homepage": "https://github.com/AuraKaliya/dsh-dafeiyu#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "memory",
    "qq",
    "bilibili"
  ],
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "zod": "4.4.3",
    "ws": "8.22.0",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.2",
    "yaml": "2.9.0",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2"
  },
  "imports": {
    "#dafeiyu/activity": "./runtime/activity/lib/index.js",
