    "#dafeiyu/memory/retrieval-index": "./runtime/memory/lib/retrieval-index.js",
    "#dafeiyu/server-bootstrap": "./runtime/server-bootstrap/lib/index.js",
    "#dafeiyu/server-bootstrap/standing-authority": "./runtime/server-bootstrap/lib/standing-authority.js",
    "#dafeiyu/server-executor": "./runtime/server-executor/lib/index.js",
    "#dafeiyu/server-executor/store": "./runtime/server-executor/lib/store.js",
    "#dafeiyu/server-executor/types": "./runtime/server-executor/lib/types.js",
    "#dafeiyu/server-executor/child": "./runtime/server-executor/lib/child.js",
    "#dafeiyu/server-executor/ipc": "./runtime/server-executor/lib/ipc.js",
    "#dafeiyu/server-executor/protocol": "./runtime/server-executor/lib/protocol.js",
    "#dafeiyu/server-executor/budget": "./runtime/server-executor/lib/budget.js",
    "#dafeiyu/server-executor/windows-process": "./runtime/server-executor/lib/windows-process.js",
    "#dafeiyu/server-runtime": "./runtime/server-runtime/lib/index.js",
    "#dafeiyu/server-runtime/launch-config": "./runtime/server-runtime/lib/launch-config.js",
    "#dafeiyu/server-runtime/cli": "./runtime/server-runtime/lib/cli.js",
    "#dafeiyu/timeline": "./runtime/timeline/lib/index.js"
  },
  "dafeiyuPackages": {
    "#dafeiyu/activity": "0.1.0",
    "#dafeiyu/bilibili": "0.1.0",
    "#dafeiyu/qq": "0.3.0",
    "#dafeiyu/channel-simulator": "0.4.0",
    "#dafeiyu/contracts": "0.15.0",
    "#dafeiyu/core": "0.15.0",
    "#dafeiyu/host": "0.1.0",
    "#dafeiyu/journal": "0.4.0",
    "#dafeiyu/media": "0.1.0",
    "#dafeiyu/memory": "0.15.0",
    "#dafeiyu/server-bootstrap": "0.1.0",
    "#dafeiyu/server-executor": "0.1.0",
    "#dafeiyu/server-runtime": "0.1.0",
    "#dafeiyu/timeline": "0.8.0"
  }
