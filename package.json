{
  "name": "dafeiyu-project",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && tsc -p tests/tsconfig.json && node --test build-tests/*.test.js",
    "demo": "npm run build && tsc -p tests/tsconfig.json && node scripts/demo.mjs",
    "check": "npm test",
    "accept:model": "npm run build && node scripts/accept-real-model.mjs",
    "qq:mock": "npm run build && tsc -p tests/tsconfig.json && node scripts/run-local-qq.mjs B",
    "qq:real": "npm run build && tsc -p tests/tsconfig.json && node scripts/run-local-qq.mjs C",
    "qq:stop": "node scripts/stop-local-qq.mjs",
    "demo:timeline": "npm run build && tsc -p tests/tsconfig.json && node scripts/demo-timeline.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-query-sqlite": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3",
    "ws": "8.22.0",
    "yaml": "2.9.0"
  }
}
